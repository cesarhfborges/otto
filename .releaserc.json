{
    "branches": ["master", { "name": "beta", "prerelease": true }],
    "tagFormat": "v${version}",
    "plugins": [
        ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
        ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
        [
            "@semantic-release/exec",
            {
                "verifyReleaseCmd": "[ -z \"$EXPECTED_VERSION\" ] || [ \"${nextRelease.version}\" = \"$EXPECTED_VERSION\" ] || { echo \"Expected $EXPECTED_VERSION, got ${nextRelease.version}: the builds are for another version.\" >&2; exit 1; }"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    { "path": "release/*.AppImage" },
                    { "path": "release/*.deb" },
                    { "path": "release/*.exe" },
                    { "path": "release/*.dmg" },
                    { "path": "release/*.zip" },
                    { "path": "release/latest*.yml" },
                    { "path": "release/beta*.yml" },
                    { "path": "release/*.blockmap" }
                ],
                "successCommentCondition": false,
                "failCommentCondition": false
            }
        ]
    ]
}

{
    "name": "otto",
    "productName": "Otto",
    "version": "0.1.0",
    "description": "Otto — open-source, offline-first API client (Angular + Electron), inspired by Bruno.",
    "author": {
        "name": "Cesar Borges",
        "email": "cesarhfborges@gmail.com"
    },
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "dist/electron/main/main.js",
    "scripts": {
        "ng": "ng",
        "start": "npm run electron:dev",
        "web:serve": "ng serve",
        "web:build": "ng build",
        "web:watch": "ng build --watch --configuration development",
        "electron:compile": "tsc -p electron/tsconfig.json",
        "electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
        "electron:dev": "concurrently -k -n NG,TSC,ELECTRON -c magenta,blue,green \"ng serve\" \"npm run electron:watch\" \"wait-on tcp:4200 dist/electron/main/main.js && cross-env NODE_ENV=development node scripts/run-electron.mjs\"",
        "electron:start": "npm run build && node scripts/run-electron.mjs",
        "clean": "rimraf dist release",
        "build": "npm run clean && ng build && npm run electron:compile",
        "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
        "dist": "npm run build && electron-builder",
        "dist:linux": "npm run build && electron-builder --linux",
        "dist:win": "npm run build && electron-builder --win",
        "dist:mac": "npm run build && electron-builder --mac",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "test": "ng test",
        "test:electron": "npm run electron:compile && node --disable-warning=ExperimentalWarning --test \"dist/electron/**/*.test.js\""
    },
    "build": {
        "appId": "dev.otto.app",
        "productName": "Otto",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "dist/electron/**/*",
            "dist/otto/browser/**/*",
            "assets/**/*",
            "package.json",
            "!**/*.map",
            "!dist/electron/**/*.test.js",
            "!dist/electron/main/testing/**"
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development",
            "icon": "build/icon.png",
            "maintainer": "Cesar Borges <cesarhfborges@gmail.com>"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.developer-tools",
            "icon": "build/icon.png"
        }
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@faker-js/faker": "^10.6.0",
        "fflate": "0.8.2",
        "highlight.js": "^11.12.0",
        "ngx-copypaste": "^20.0.0",
        "ngx-highlightjs": "^12.0.0",
        "quill": "^2.0.3",
        "undici": "7.30.1",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21",
        "@angular/cli": "^21",
        "@angular/common": "^21",
        "@angular/compiler": "^21",
        "@angular/compiler-cli": "^21",
        "@angular/core": "^21",
        "@angular/forms": "^21",
        "@angular/platform-browser": "^21",
        "@angular/platform-browser-dynamic": "^21",
        "@angular/router": "^21",
        "@primeuix/themes": "^2.0.0",
        "@tailwindcss/postcss": "^4.1.11",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^26.6.5",
        "autoprefixer": "^10.4.20",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "electron": "^44.9.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^4.2.1",
        "jasmine-core": "~5.4.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.0.0",
        "primeclt": "^0.1.5",
        "primeicons": "^7.0.0",
        "primeng": "^21.0.2",
        "rimraf": "^6.1.3",
        "rxjs": "~7.8.0",
        "tailwindcss": "^4.1.11",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "wait-on": "^9.5.1"
    }
}
